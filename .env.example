# ==============================================================================
# Multimodal Learning Agent - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Azure Storage (Blob Storage for Educational Documents & Assets)
# ------------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=learning-agent-documents

# ------------------------------------------------------------------------------
# Azure AI Document Intelligence (OCR, Document Layout & Table Extraction)
# ------------------------------------------------------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-docintel-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_document_intelligence_api_key

# ------------------------------------------------------------------------------
# Azure AI Search (Vector & Hybrid Searchable Knowledge Base)
# ------------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_azure_search_admin_key
AZURE_SEARCH_INDEX_NAME=learning-agent-chunks

# ------------------------------------------------------------------------------
# Azure OpenAI / Foundry Embeddings (Vector Generation)
# ------------------------------------------------------------------------------
AZURE_EMBEDDING_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_EMBEDDING_API_KEY=your_azure_openai_api_key
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_API_VERSION=2024-02-01
AZURE_EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Gemini REST API / Azure OpenAI / Mock)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
DEFAULT_TEMPERATURE=0.2
MAX_TOKENS=1500

# ------------------------------------------------------------------------------
# Azure OpenAI Chat & Generation Model (Optional Alternative Provider)
# ------------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_api_key
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ------------------------------------------------------------------------------
# Semantic Chunking Configuration
# ------------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MIN_CHUNK_SIZE=50

# ------------------------------------------------------------------------------
# Local Pipeline Configuration
# ------------------------------------------------------------------------------
PROCESSED_DATA_DIR=data/processed
LOG_LEVEL=INFO
